{
  "manifest_version": 3,
  "name": "TozaEkran — reklama bloklovchi",
  "short_name": "TozaEkran",
  "version": "1.0.0",
  "description": "Saytlardagi barcha reklamalarni bloklaydi: bannerlar, popup oynalar, video-reklamalar. asilmedia.org va kino saytlari uchun maxsus himoya.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TozaEkran",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "scripting",
    "tabs",
    "webNavigation",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "toza", "enabled": true, "path": "rules/toza.json" },
      { "id": "easylist", "enabled": true, "path": "rules/easylist.json" },
      { "id": "cyrillic", "enabled": true, "path": "rules/cyrillic.json" }
    ]
  }
}
